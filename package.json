{
  "name": "provider-agnostic-personal-context-orchestrator",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --force",
    "build:force": "tsc -b --force",
    "proof:end-to-end:non-executing": "npm run build:force && node scripts/end-to-end-non-executing-proof.mjs",
    "proof:end-to-end:non-executing:verify": "npm run build:force && node scripts/verify-end-to-end-non-executing-proof.mjs",
    "proof:invocation-denial:verify": "npm run build:force && node scripts/verify-invocation-denial-proof.mjs",
    "proof:handler-boundary-denial:verify": "npm run build:force && node scripts/verify-handler-boundary-denial-proof.mjs",
    "proof:surface-boundary-denial:verify": "npm run build:force && node scripts/verify-surface-boundary-denial-proof.mjs",
    "proof:authority-boundary-denial:verify": "npm run build:force && node scripts/verify-authority-boundary-denial-proof.mjs",
    "contract:agent-context-request:verify": "npm run build:force && node scripts/verify-agent-context-request-boundary.mjs",
    "contract:local-deterministic-context-source:verify": "npm run build:force && node scripts/verify-local-deterministic-context-source-adapter.mjs",
    "contract:agent-consumable-response:verify": "npm run build:force && node scripts/verify-agent-consumable-response-contract.mjs",
    "contract:first-protocol-surface-adapter:verify": "npm run build:force && node scripts/verify-first-protocol-surface-adapter-shape.mjs",
    "contract:local-json-request-response-runner:verify": "npm run build:force && node scripts/verify-local-json-request-response-runner-shape.mjs",
    "proof:local-json-fixture-runner:verify": "npm run build:force && node scripts/verify-local-json-fixture-runner-proof.mjs",
    "contract:minimal-local-json-fixture-runner-cli-boundary:verify": "npm run build:force && node scripts/verify-minimal-local-json-fixture-runner-cli-boundary.mjs",
    "tool:local-json-request-fixture:write": "npm run build:force && node scripts/local-json-request-fixture-authoring-cli.mjs",
    "tool:local-json-fixture-runner:run": "npm run build:force && node scripts/local-json-fixture-runner-cli.mjs",
    "tool:local-json:run": "npm run build:force && node scripts/local-json-single-command-runner.mjs",
    "tool:first-local-json-cli-file-io-boundary:verify": "npm run build:force && node scripts/verify-first-local-json-cli-file-io-boundary.mjs",
    "tool:local-json-request-fixture-authoring:verify": "npm run build:force && node scripts/verify-local-json-request-fixture-authoring-helper.mjs",
    "tool:local-json-single-command-run:verify": "npm run build:force && node scripts/verify-local-json-single-command-run-wrapper.mjs",
    "tool:constrained-local-json-request-variation:verify": "npm run build:force && node scripts/verify-constrained-local-json-request-variation.mjs",
    "tool:minimal-local-source-fixture-selection:verify": "npm run build:force && node scripts/verify-minimal-local-source-fixture-selection.mjs",
    "tool:local-json-response-observation-summary:verify": "npm run build:force && node scripts/verify-local-json-response-observation-summary.mjs",
    "tool:agent-readable-response-use-guidance:verify": "npm run build:force && node scripts/verify-agent-readable-response-use-guidance.mjs",
    "tool:agent-request-response-schema:print": "npm run build:force && node scripts/local-json-agent-contract-schema-cli.mjs",
    "tool:agent-request-response-schema:verify": "npm run build:force && node scripts/verify-agent-request-response-schema-export.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
